# -----------------------------------------------------------------------------
# Trakt landing page — environment
#
# Copy to `.env.local` for development. In Azure these become App Service
# application settings (or Container Apps environment variables / secrets).
# Nothing here is committed with a real value.
#
# Production configuration is validated at startup by `src/lib/config.ts`.
# Anything unsafe is an ERROR, not a warning: the process refuses to start
# rather than quietly dropping leads, issuing forgeable sessions or advertising
# a localhost canonical URL. Run `npm run validate-config` to exercise the rules.
# -----------------------------------------------------------------------------

# --- Site ---------------------------------------------------------------------
# Canonical public origin. Drives metadataBase, canonical URL, Open Graph,
# JSON-LD, sitemap, robots and same-origin enforcement.
#
# In production this must be: present, https, a BARE ORIGIN (no path, query or
# fragment) and not a loopback host. No Trakt hostname is hard-coded anywhere —
# trakt.<domain>, www.<domain> and demo.<domain> all work unchanged.
#
# It is inlined at BUILD time as well as read at runtime, so set it for the
# build too, or the old origin stays in the canonical link and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Display name of the synthetic demonstration client.
NEXT_PUBLIC_DEMO_NAME=Synthetic Demo Lender

# development | test | staging | production.
# `production` enables secure cookies and turns on every check below.
APPLICATION_ENV=development

# --- Demo API -----------------------------------------------------------------
# Reserved. Unset today: the demo is served from the committed demo pack, in
# process. Set only if a future deployment proxies a separate private service.
# DEMO_API_BASE_URL=

# Signs the demo-session cookie (question/report counters). REQUIRED in
# production: at least 32 characters with real variation. A random ephemeral
# key is used in development.
# Generate: openssl rand -hex 32
DEMO_SESSION_SECRET=

# --- Demo session limits ------------------------------------------------------
DEMO_MAX_QUESTIONS_PER_SESSION=12
DEMO_MAX_REPORTS_PER_SESSION=3
DEMO_SESSION_TTL_SECONDS=7200
DEMO_MAX_QUESTION_LENGTH=240
DEMO_MAX_BODY_BYTES=4096

# --- Rate limits (per client IP) ----------------------------------------------
RATE_LIMIT_DEMO_PER_MINUTE=30
RATE_LIMIT_REPORT_PER_MINUTE=10
RATE_LIMIT_LEAD_PER_HOUR=5
ANALYTICS_RATE_LIMIT_PER_MINUTE=120

# Shared counter store. REQUIRED in production unless ALLOW_IN_MEMORY_RATE_LIMIT
# is set. Any endpoint satisfying this contract will do — no client library and
# no new dependency is involved:
#
#   POST {RATE_LIMIT_STORE_URL}   { "key": "...", "windowSeconds": 60 }
#   → 200                         { "count": 3, "resetAt": 1730000000000 }
#
# RATE_LIMIT_STORE_URL=
RATE_LIMIT_STORE_TIMEOUT_MS=250

# Deliberate acceptance of in-process counters in production.
#
# Correct ONLY on a single instance. With N replicas each keeps its own
# counters, so every limit is effectively multiplied by N. Left false so that
# scaling out without a shared store fails validation instead of silently
# under-limiting. Set true only when you have consciously decided to run one
# instance — see README § "Single-instance operation".
ALLOW_IN_MEMORY_RATE_LIMIT=false

# --- Lead delivery ------------------------------------------------------------
# email | webhook | file | console.
#   email   — transactional email provider (Resend-compatible JSON API)
#   webhook — POST to a CRM/automation endpoint, optionally HMAC-signed
#   file    — DEVELOPMENT ONLY; appends to LEAD_STORE_DIR/leads.jsonl
#   console — DEVELOPMENT ONLY; a structured log line (used by the test suites)
#
# `file` and `console` are REFUSED in production: leads would never reach a
# human, and a landing page that silently discards enquiries is worse than one
# that will not start.
LEAD_DELIVERY_PROVIDER=file
LEAD_STORE_DIR=.leads

# Production (preferred):
# LEAD_DELIVERY_PROVIDER=email
# EMAIL_PROVIDER=resend
# EMAIL_API_URL=https://api.resend.com/emails
# EMAIL_API_KEY=                      # server-side only; never NEXT_PUBLIC_
# LEAD_FROM_EMAIL=trakt-website@<your-domain>     # must be a verified sender
# LEAD_NOTIFICATION_EMAIL=sales@<your-domain>     # where enquiries land

# Production (alternative):
# LEAD_DELIVERY_PROVIDER=webhook
# CRM_WEBHOOK_URL=
# CRM_WEBHOOK_SECRET=                 # enables an x-trakt-signature HMAC header

LEAD_DELIVERY_TIMEOUT_MS=8000

# Minimum milliseconds a form must be on screen before submission is accepted.
LEAD_MIN_FILL_MS=2500

# --- Analytics ----------------------------------------------------------------
# none | appinsights | firstparty.
#   none        — records nothing, anywhere. The default.
#   appinsights — uses the browser snippet if an operator loaded it, else the
#                 first-party collector. Requires the connection string below.
#   firstparty  — POSTs to this origin's own /api/analytics collector.
#
# Only the ten allow-listed events are ever recorded, with low-cardinality
# identifier properties. Never: question text, answer content, names, email
# addresses, or any identifier that outlives the session.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Demo video ---------------------------------------------------------------
# There is no video section on the page and no video asset in the repository, so
# no video setting is read today. README § "Adding a product overview video"
# documents the settings to re-add alongside the component.

# --- Misc ---------------------------------------------------------------------
# NEXT_PUBLIC_CONTACT_EMAIL=
# PORT=3000
