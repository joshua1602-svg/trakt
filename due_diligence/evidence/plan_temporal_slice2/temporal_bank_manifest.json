      "id": "T12",
      "question": "What will funded balance be over the next three months?",
      "category": "future_period",
      "expected_interpretation_disposition": "REFUSE",
      "temporal_required": false,
      "expected_eligibility": "NOT_REACHED",
      "expected_snapshots": null,
      "expected_measure_concept": null,
      "expected_statistics": [],
      "expected_filters": [],
      "expected_dimensions": [],
      "expected_population_base": "funded",
      "note": "A forward-looking period on a capability that owns no forward methodology. Expected to refuse at the compiler; if the model instead routes it to the forecast capability, that is a JUSTIFIED_REFUSE at the perimeter and is recorded as such."
    },
    {
      "id": "T13",
      "question": "How has funded balance changed over the last twenty-four months?",
