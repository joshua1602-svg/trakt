        "sum"
      ],
      "expected_filters": [],
      "expected_dimensions": [],
      "expected_population_base": "funded",
      "note": "The book carries eight periods. The resolver must clarify with PERIOD_NOT_AVAILABLE and must not return a shorter series."
    },
    {
      "id": "T14",
      "question": "Why did funded balance increase last month?",
      "category": "movement_cause",
