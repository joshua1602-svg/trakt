{
  "bank_id": "slice2_temporal_live_v1",
  "purpose": "prove the Opus -> temporal CandidateIntent -> GovernedQueryPlan -> slice 2 perimeter -> SnapshotSelector boundary on fresh live interpretations",
  "boundary_under_test": [
    "raw question",
    "OpusInterpreter.interpret",
    "CandidateIntent",
    "DeterministicCompiler.compile",
    "GovernedQueryPlan",
    "plan_temporal_runtime.check_temporal_eligibility",
    "plan_temporal_runtime.resolve_temporal",
    "SnapshotSelector",
    "resolved snapshot headers"
  ],
  "stops_before": [
    "execute_mi_query",
    "any MI API call",
    "any serving surface",
    "any deployment"
  ],
  "model": "claude-opus-5",
  "authorised_live_calls": 15,
  "retry_policy": "exactly one call per case; a failure is RECORDED, never retried, reworded or probed",
  "fixture_catalogue": [
    "2025-11-30",
    "2025-12-31",
    "2026-01-31",
    "2026-02-28",
    "2026-03-31",
    "2026-04-30",
    "2026-05-31",
    "2026-06-30"
  ],
  "fixture_cadence": "monthly",
  "relative_windows_resolve_against": "the catalogue's latest reporting period, never wall-clock",
  "what_is_pinned": [
    "slice 2 eligibility",
    "the resolved snapshot set",
    "measure concept",
    "statistic (from the allowed set)",
    "filters",
    "dimensions",
    "population base",
    "the absence of any physical date or snapshot id"
  ],
  "what_is_not_pinned": [
    "which span form the model chose (series or range)",
    "which operation the model chose (series, breakdown or point_in_time)",
    "the model's own wording of the period label"
  ],
  "cases": [
    {
      "id": "T01",
      "question": "How has funded balance changed over the last six months?",
      "category": "last_n_months",
      "expected_interpretation_disposition": "PLAN",
      "temporal_required": true,
      "expected_eligibility": "ELIGIBLE",
      "expected_snapshots": [
        "2026-01-31",
        "2026-02-28",
        "2026-03-31",
        "2026-04-30",
        "2026-05-31",
        "2026-06-30"
      ],
      "expected_measure_concept": "current_outstanding_balance",
      "expected_statistics": [
        "sum"
      ],
      "expected_filters": [],
      "expected_dimensions": [],
      "expected_population_base": "funded",
      "note": "The span is stated as a COUNT of months. The resolver can only honour it if the model supplies periods_back=6; a labels-only interpretation clarifies, and that would be the finding."
    },
    {
      "id": "T02",
      "question": "What was the funded book balance in each of the last three months?",
      "category": "last_n_months",
      "expected_interpretation_disposition": "PLAN",
      "temporal_required": true,
      "expected_eligibility": "ELIGIBLE",
      "expected_snapshots": [
        "2026-04-30",
        "2026-05-31",
        "2026-06-30"
      ],
      "expected_measure_concept": "current_outstanding_balance",
      "expected_statistics": [
        "sum"
      ],
      "expected_filters": [],
      "expected_dimensions": [],
      "expected_population_base": "funded",
      "note": ""
    },
    {
      "id": "T03",
      "question": "What was funded balance each month?",
      "category": "each_month",
      "expected_interpretation_disposition": "PLAN",
      "temporal_required": true,
      "expected_eligibility": "ELIGIBLE",
      "expected_snapshots": [
        "2025-11-30",
        "2025-12-31",
        "2026-01-31",
        "2026-02-28",
        "2026-03-31",
        "2026-04-30",
        "2026-05-31",
        "2026-06-30"
      ],
      "expected_measure_concept": "current_outstanding_balance",
      "expected_statistics": [
        "sum"
      ],
      "expected_filters": [],
      "expected_dimensions": [],
      "expected_population_base": "funded",
      "note": "No count and no anchor: the whole available series. Needs a label the governed span vocabulary recognises."
