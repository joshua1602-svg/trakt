# -----------------------------
# Python & System
# -----------------------------
__pycache__/
*.pyc
*.pyo
venv/
.venv/
.env
.DS_Store
.vscode/
.idea/

# -----------------------------
# DATA & SAMPLES (Governance)
# -----------------------------
# Exclude the specific samples folder
data/samples/
# Exclude raw input data but keep the folder structure
data/input/*

# -----------------------------
# GENERATED ARTEFACTS
# -----------------------------
*.csv
*.xlsx
*.xls
*.xml

# Intentional, version-controlled config-review artefacts (committed on purpose).
!output/config_review/
!output/config_review/*.csv

# Generated JSON (but NOT configs / schemas)
run_manifest.json
*lineage*.json
*out*.json

# Phase 8E — dev-only live Anthropic smoke artefacts (may contain provider
# responses; never commit). The directory is kept via artifacts/.gitkeep.
artifacts/*
!artifacts/.gitkeep

# -----------------------------
# OUTPUT DIRECTORIES
# -----------------------------
out/
out_validation/
logs/
*.log

# -----------------------------
# SECRETS (defensive)
# -----------------------------
*secret*
*key*
*cred*
# Legitimate source module wrongly caught by the defensive "*key*" rule above.
!snapshot/keys.py

# -----------------------------
# ALLOW CONFIG / SCHEMA FILES
# -----------------------------
!**/*.yaml
!**/*.yml
!**/*schema.json
!pyproject.toml

# -----------------------------
# Exception Management DB
# -----------------------------
*.db

# -----------------------------
# Compressed Archives
# -----------------------------
*.zip
*.7z
*.rar
*.tar.gz
# Demo fixtures
!demo/*.csv

# Trakt Onboarding Agent v2 generated packs
onboarding_output/
!synthetic_onboarding_pack/*.csv
# Onboarding Agent Phase 1 — domain-based synthetic packs (committed fixtures)
!synthetic_onboarding_pack_domain_based/scenario_a_combined/*.csv
!synthetic_onboarding_pack_domain_based/scenario_b_split/*.csv
# Onboarding Agent — committed test fixtures (synthetic, no real data)
!tests/fixtures/*.csv
# MI runtime — committed synthetic multi-artefact fixtures (subdirectories)
!tests/fixtures/**/*.csv
portfolio_test/

# Operations Control Centre local runtime state (staging, projected client memory)
.ops_state/

# OCC Agent synthetic case sandbox (artefacts, run working files, readiness
# packages). Practice-case data only — never a source artefact.
.occ-agent-synthetic/

# Stray root-level node_modules (e.g. vitest .vite cache)
node_modules/

# mi_agent_pptx generated investor decks + intermediate chart PNGs
reports/*.pptx
reports/*_charts/

# Trakt product-demonstration environment (regenerated by demo_platform/run_demo.py)
demo_platform/workspace/
demo-video/node_modules/
demo-video/out/

# The multi-book demonstration commits only the inputs and the artefacts the
# landing-page demo pack reads. Per-book intermediates and dashboards are
# regenerable with synthetic_demo/run_multibook_pipeline.sh.
synthetic_demo/output/multibook/*_canonical_full.csv
synthetic_demo/output/multibook/*_canonical_typed.csv
!synthetic_demo/output/multibook/platform_*_canonical_typed.csv
synthetic_demo/output/multibook/*_2026-05-31_header_mapping_report.json
synthetic_demo/output/multibook/*_2026-05-31_transform_report.json
synthetic_demo/output/multibook/*_provenance_manifest.json
synthetic_demo/output/multibook/validation/*_dashboard.json
synthetic_demo/output/multibook/validation/platform_2026-05-31_*
# Annex-named pipeline artefacts are regenerable and their PATHS fall under the
# regulatory change freeze that tests/test_*::test_no_regulatory_or_annex2_files_modified
# enforces. The demo commits only the reconciliation, which carries the preflight
# verdict it needs.
synthetic_demo/output/multibook/*ESMA_Annex2*

# Asset-class hardening framework run evidence (simulation/runner.py).
# Generated sources, canonical outputs and run summaries are reproducible from
# the committed manifests and are never committed themselves.
out_simulation/

# --- ESMA Annex 2 Regulatory Watch (Stage 1) ---------------------------------
# Immutable source snapshots are byte-for-byte copies of the vendored ESMA
# artefacts (the workbook alone is ~10 MB). They are evidence for a run, not
# repository content: the artefacts themselves are already tracked, and the
# report JSON records each snapshot's sha256. The generated reports ARE kept.
output/regulatory_watch/**/snapshots/
output/regulatory_watch/**/candidate/
output/regulatory_watch/**/seen_publications.json
output/regulatory_watch/**/replay_state.json
output/regulatory_watch/discovery_demo/stage1a/

# Stage 1B publication fixtures are committed test INPUT, not generated output.
# The blanket *.xml rule above would otherwise drop the RSS fixture and break
# the discovery suite on a fresh clone.
!tests/fixtures/regulatory_watch/publications/*.xml

# Synthetic second book, rebuilt on demand by
# question_interpretation/run_robustness_deterministic.py
question_interpretation/.kestrelmoor_store/
